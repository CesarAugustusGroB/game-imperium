{
  "$schema": "./soldiers.schema.json",
  "description": "Catalog of soldier sprites used by the battle renderer and UI. Each entry describes the visual content of the artwork so designers and engineers can pick the right sprite without opening the file. Rarity and format fields are authoritative — see style-guide.json for the per-rarity art-treatment rules.",
  "conventions": {
    "shape": "Circle sprites are designed to be displayed inside a circular clip with ~4% margin. Card sprites (leader tier) use 5:7 portrait orientation with full-art bleed.",
    "orientation": "Facing-forward framing (character centered, head and shield/weapon visible).",
    "resolution": "Source rasters are ~800–1400 px per side; the renderer downsamples to 60 * DPR (or 120 * DPR in high-res mode) via SpriteManager.loadShield().",
    "colorSpace": "sRGB, 8-bit RGBA, anti-aliased edges against transparent background.",
    "filenamePattern": "{culture}_{rarity}_{format}.png — e.g. gallic_common_soldier.png, spartan_royal_super-rare_soldier.png, commander_leader_card.png",
    "filenameFields": {
      "culture":  "lowercase snake_case (gallic, roman, spartan_royal, athens_hoplite, persian_immortal, companion, war_elephant)",
      "rarity":   "common | uncommon | rare | super-rare | secret-rare | leader (hyphenated in filenames, mirrors style-guide.json rarity ids)",
      "format":   "soldier (circle portrait) | card (5:7 full-art, reserved for leaders)"
    },
    "spriteIdPattern": "{culture}_{rarity} — same as filename but with underscores only (super_rare, secret_rare). This is the JS-friendly key used in SpriteManager.shields and BattleUnit.spriteId."
  },
  "factions": {
    "blue": {
      "label": "Spartan / Hellenic",
      "paletteHint": "bronze, blue cloak, red accents",
      "roles": {
        "vanguard": "spartan_rare_soldier.png",
        "reserve":  "spartan_royal_super-rare_soldier.png",
        "guard":    "athens_hoplite_uncommon_soldier.png"
      }
    },
    "red": {
      "label": "Persian Empire",
      "paletteHint": "gold, crimson, lapis",
      "roles": {
        "vanguard": "persian_immortal_uncommon_soldier.png",
        "reserve":  "persian_immortal_uncommon_soldier.png",
        "guard":    "persian_immortal_uncommon_soldier.png"
      },
      "note": "All three Persian roles currently reuse the Immortal portrait — see src/battle/render/SpriteManager.ts."
    }
  },
